# =============================================================================
# CLINICAL IMAGE ANALYSIS WORKBENCH - .gitignore
# Python + PyQt6 + NumPy + pydicom + Pillow
# =============================================================================

# -------------------------
# Python Core (Keep these)
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
MANIFEST

# -------------------------
# Virtual Environments
# -------------------------
.venv/
venv/
env/
ENV/
*.env
.envrc

# -------------------------
# Testing & Coverage
# -------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.cover

# -------------------------
# IDE & Editor Files
# -------------------------
# VS Code
.vscode/
*.code-workspace
# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
# Spyder
.spyderproject
.spyproject
# Sublime / Vim / Emacs
*.swp
*.swo
*~
.project
.settings/

# -------------------------
# OS & System Files
# -------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------
# Jupyter / Notebooks (if used for testing)
# -------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -------------------------
# Project-Specific: Clinical Images
# -------------------------
# Ignore large raw DICOM test files (store samples in /assets/ if <1MB)
/test_data/*.dcm
/test_data/raw/
*.raw
*.nii
*.nii.gz

# Ignore exported/processed images (users generate these at runtime)
/exported/
/processed_output/
*.processed.jpg
*.processed.bmp

# -------------------------
# Temporary & Runtime Files
# -------------------------
*.log
temp/
tmp/
*.tmp
*.temp
*.lock
*.pid

# -------------------------
# Documentation Build Outputs
# -------------------------
docs/_build/
*.pdf
*.aux
*.toc
*.lof
*.lot

# -------------------------
# Secrets & Credentials (NEVER commit these)
# -------------------------
secrets.json
credentials.json
api_keys.txt
*.pem
*.key

# -------------------------
# WHAT TO COMMIT (Reminder)
# -------------------------
